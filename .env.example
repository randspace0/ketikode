# Required, at least 32 characters. Generate one: openssl rand -hex 32
SESSION_SECRET=
DB_PASSWORD=ketide
# Set to 1 when served over HTTPS so the login cookie is HTTPS-only.
COOKIE_SECURE=
# Optional: set both to enable the /admin submissions page.
ADMIN_USER=
ADMIN_PASSWORD=
# Set to 1 only behind a reverse proxy you control, so rate limits use X-Forwarded-For.
TRUST_PROXY_HEADERS=
